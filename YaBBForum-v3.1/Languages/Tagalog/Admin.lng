%gztxt = (
'1' => qq~Gumamit ng Output Compression?<br /><span class="small">Pinababawasan ng Output Compression ang bandwidth na ginagamit sa pakikipag-ugnayan sa browser ng user.<br />Available lang ang (mga) opsyon kung sinusuportahan sila ng server. Maaari mong itakda ang path sa gzip utility ng iyong server sa <a href="$boardurl/AdminIndex.$yyaext?action=backupsettings">Backup Utility</a></span>~,
'2' => 'Ipadala ang Output na laging naka-compress?<br /><span class="small">Checked = Hindi sinusuri ng YaBB kung sinusuportahan ng browser ang Compression, at palaging pini-compress ang output. ** Maaari nitong gawing hindi magagamit ang iyong forum para sa mga mas lumang browser. **<br />Not Checked = Sinusuri ng YaBB kung sinusuportahan ng browser ang Compression at gumagamit lamang ng Compression (kung pinili sa itaas) kapag sinusuportahan ng browser.</span>',
'3' => 'Walang Output Compression',
'4' => 'Compression gamit ang panlabas na GZip Program',
'5' => 'Compression gamit ang Compress::Zlib Module',
);

