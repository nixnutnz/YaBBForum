$emaildesc{'boardnewtopicnotificationemail'} = qq~Ang Notification E-mail (Board-Level, Bagong Paksa)~;
$boardnewtopicnotificationemail = qq~Isang bagong paksa, "{yabb subject}", ay nai-post mula sa {yabb tauthor} sa isang board na iyong pinapanood.

