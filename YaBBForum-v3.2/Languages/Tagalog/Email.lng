$emaildesc{'sendtopicemail'} = qq~Ang E-mail para sa pagpapadala ng Paksa~;
$sendtopicemail = qq~Mahal na {yabb toname},
Gusto kong tingnan mo ang sumusunod na paksa, "{yabb subject}", sa {yabb mbname}. Upang tingnan ito, mangyaring i-click ang link sa ibaba:

<a href="{yabb scripturl}?num={yabb num}">{yabb scripturl}?num={yabb num}</a>

salamat,
{yabb displayname}~;

