$backuplngver = 'YaBBForum 3.1';

$script_root = $ENV{'SCRIPT_FILENAME'};
kung( ! $script_root ) {
    $script_root = $ENV{'PATH_TRANSLATED'};
}
($support_env_path = $script_root) =~ s~/\w+\.pl~~;

%backup_txt = (
'1' => 'YaBB Backup',
'2' => 'Hindi mo pa nai-save ang iyong mga backup na setting. Dapat mong piliin at i-save ang iyong mga setting bago mo mai-backup ang iyong forum.',
'3' => 'Piliin kung aling mga direktoryo ang iba-backup. Tandaan: ginagamit ng mga backup na gawain ang mga path ng direktoryo mula sa Forum Configuration -> Path Settings; siguraduhing tama ang mga ito.',
'4' => 'Mga Direktoryo upang I-backup',
'5' => 'Suriin/Alisin ang tsek Lahat',
'6' => 'Kung pipiliin mo ang bawat direktoryo, magkakaroon ka ng kumpletong kopya ng iyong forum. Ito ang inirerekomendang setting para sa karamihan ng mga forum.<br />Gayunpaman, para sa <i>napaka</i> malalaking forum, ang isang buong backup ay maaaring magdulot ng mga problema sa pagbawi (hal. timeout). Para sa mga ganoong malalaking forum, maaaring mas mainam na lumikha ng isang backup ng "static" na mga direktoryo ng balangkas lamang (na napakakaunting nagbabago) at hiwalay na mga backup para sa bawat isa sa mga direktoryo ng Boards, Members at Messages.',
'path1' => 'Path sa Tar at Zip:',
'path2' => 'Path sa gzip at bzip2 (nagtatakda din ng path sa gzip sa Advanced na Mga Setting):',
'path3' => 'Punan ang mga landas <b>lamang</b> kung hindi awtomatikong mahanap ng YaBB ang Tar, Zip, gzip, at bzip2. Kung hindi, iwanang blangko ang mga puwang sa itaas.',

# Simulan ang paglalarawan ng mga direktoryo
# Hindi namin isinasalin ang mga pangalan ng direktoryo tulad ng Boards/.
'7' => '-- (naglalaman ng impormasyon ng kategorya at board at mga index)',
'8' => '-- (naglalaman ng lahat ng mga thread/paksa at kasamang mga post)',
'9' => '-- (naglalaman ng mga profile ng miyembro, log ng miyembro, at personal na mensahe)',
'10' => 'and stylesheets', # Ito ay lalabas pagkatapos ng "Templates/ "
'10a' => '-- (naglalaman ng lahat ng template file at larawan)',
'11' => '-- (naglalaman ng lahat ng naka-localize na text at support file na ginagamit ng YaBB)',
'12' => '-- (naglalaman ng mga setting ng forum, mga kagustuhan, at mga log)',
'at' => 'at', # Kakaibang pangalan, oo, ngunit maaaring maging kapaki-pakinabang sa higit sa isang lugar
'13' => 'plus lahat ng iba pang source code -- (naglalaman ng kumpletong YaBB source code)',
'14' => '-- (naglalaman ng mga larawan at stylesheet para sa lahat ng mga template, ngunit <i>ibinubukod</i> ang mga direktoryo ng pag-upload ng mga Attachment at Avatar ng user [tingnan ang susunod na linya])',
'14a' => '-- (naglalaman ng mga file na na-upload ng user: mga attachment at avatar)',

# Simulan ang pagpili ng backup na paraan
'15' => 'Backup at Compression Methods',

# Huwag isalin ang mga pangalan ng command (tulad ng /bin/tar) o 'tar'.
'16' => q~<i>Backup:</i> Ang Tar (na may compression) o Zip, gamit ang standalone UNIX utilities, ay ang mga inirerekomendang pagpipilian. Archive::Tar (na may compression) o Archive::Zip ay dapat gamitin lamang kung ang Tar/Zip ay hindi available, dahil ang Perl modules ay mas mabagal kaysa sa mga standalone na utility.<br /><br /><i>Compression:</i> Kung gagamit ka ng Tar, mahigpit na inirerekomenda ang compression upang panatilihing maliit ang mga sukat ng archive. (Naka-compress na ang Zip.) Gumagawa ang Bzip2 ng mas maliliit na archive kaysa sa Gzip o Zip, ngunit mas tumatagal; ito ay maaaring isang isyu para sa mabagal na mga server na may malalaking forum.<br /><br /><span style="color: red;"><b>Tandaan:</b></span> Ang ilang mga server ay hindi sumusuporta sa malalaking backup na mga file. Kung makakita ka ng mensahe ng error tulad ng "Internal na error sa server" o kahit isang blangkong page, sumubok ng ibang backup at/o compression na paraan. Kung nabigo pa rin iyon, subukang gumawa ng maramihang mas maliliit na backup sa pamamagitan ng hiwalay na pag-back up ng mas kaunting mga direktoryo (nasuri sa itaas). <br /><span style="color: red;"><b>Tandaan:</b></span>: Maaaring hindi i-save ng Tar ang mga file sa 'root' ng yabb2 o yabbfiles na mga folder. Sa kaganapang iyon, kung kailangan mong i-archive ang <i>lahat</i> na file o kailangan mo ng archive/backup bilang paghahanda sa paglipat ng iyong forum, gamitin ang Zip o Archive::Tar sa halip.~,
'17' => 'Walang Tar compression',
'18' => '(para sa Tar compression)',
'19' => 'Archive Destination Directory (upang hawakan ang mga backup na file)',
'19a' => "Gamitin ang buong landas (hal. $support_env_path/Backups), hindi kamag-anak na landas (hal. ./Backups)",
'19b' => 'Backup na Paalala',
'19c' => 'Magpakita ng alerto kung walang naisagawang backup sa',
'19d' => 'mga araw. Ilagay ang zero o iwanang blangko upang huwag paganahin ang paalala.',
'20' => 'I-save ang Mga Setting',

# Magsimulang magpatakbo ng backup na lugar
'21' => 'Patakbuhin ang Backup',
'22' => 'I-click ang button sa ibaba upang magpatakbo ng backup. Ang mga backup ay naka-imbak sa Archive Destination Directory (',
'23' => '), itinakda sa itaas.',
'24' => '<span class="important">Sa panahon ng pag-backup, ang iyong forum ay awtomatikong ilalagay sa Maintenance Mode.<br /><br /><b>Tandaan:</b></span> Para sa mga backup ng napakalaking forum, maaaring tumagal ng ilang sandali hanggang sa mag-refresh ang pahina - maging handa na maghintay ng hindi bababa sa 5 minuto. Kung nakakaranas ka ng timeout o walang nangyari pagkalipas ng 5 minuto, isaalang-alang ang <span style="color:red;">TANDAAN</span> sa itaas sa 'Backup Method' patungkol sa malalaking backup na file.<br /><br />Pagkatapos magpatakbo ng kahit isang regular na backup, maaari mong piliin kung puno na ang mga kasunod na pag-backup (lahat ng mga file sa mga direktoryo na nasuri sa itaas) o incremental na nagbago (mula noong huling backup na mga file). Kung babaguhin mo (at i-save) ang alinman sa mga setting sa itaas, ang susunod na backup <i>dapat</i> ay isang buong backup. Para sa mga incremental na backup, ang agwat ng oras para sa pagtukoy ng mga binagong file ay sinusukat sa <i>segundo</i> para sa Tar, Archive::Tar at Archive::Zip ngunit sa <i>araw</i> para sa Zip.',
'25' => 'Patakbuhin ang Buong Backup - lahat ng file sa mga napiling direktoryo',
'25a' => 'Patakbuhin ang Incremental Backup - mga file lang ang nabago/nalikha simula',

# Hindi ginagamit
