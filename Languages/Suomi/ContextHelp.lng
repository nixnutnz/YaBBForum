'teletype' => "Muuta teksti Teletype-tekstiksi:<br /><br />Valitse teksti: bla bla [SELECT]Terve maailma[/SELECT] bla bla<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b> bla bla [tt]Terve maailma[/tt] bla bla<br /><br /><b>Tulos:</b> bla bla <tt>Terve maailma</tt> bla bla",
'code' => "Lis‰‰ koodi laatikkoon:<br /><br />Valitse koodi:<br /><br />[SELECT]&lt\;table&gt\;<br />&nbsp\; &lt\;tr&gt\;&lt\;td&gt\;Terve maailma&lt\;/td&gt\;&lt\;/tr&gt\;<br />&lt\;/table&gt\;[/SELECT]<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b><br /><br />[code]&lt\;table&gt\;<br />&nbsp\; &lt\;tr&gt\;&lt\;td&gt\;Terve maailma&lt\;/td&gt\;&lt\;/tr&gt\;<br />&lt\;/table&gt\;[/code]<br /><br /><b>Tulos:</b><br /><br /><b>Koodia:</b>[CODE]&lt\;table&gt\;<br />&nbsp\; &lt\;tr&gt\;&lt\;td&gt\;Terve maailma&lt\;/td&gt\;&lt\;/tr&gt\;<br />&lt\;/table&gt\;[/CODE]",
'quote2' => "Lis‰‰ lainaus laatikkoon:<br /><br />Valitse lainattava teksti: [SELECT]Ollakko vai eikˆ olla...[/SELECT]<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b> [quote]Ollakko vai eikˆ olla...[/quote]<br /><br /><b>Tulos:</b><br /><br /><b>Lainaus:</b>[QUOTE]Ollakko vai eikˆ olla...[/QUOTE]",
'edit' => "Lis‰‰ Viestimuokkaus laatikkoon:<br /><br />Valitse viestimuokkaus: [SELECT]Liitin uuden zip-paketin.[/SELECT]<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b> [edit]Liitin uuden zip-paketin.[/edit]<br /><br /><b>Tulos:</b><br /><br /><b>Muokattu:</b>[EDIT]Liitin uuden zip-paketin.[/EDIT]",
'sup' => "Muuta teksti yl‰indeksiksi:<br /><br />Valitse teksti: bla bla [SELECT]Terve maailma[/SELECT] bla bla<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b> bla bla [sup]Terve maailma[/sup] bla bla<br /><br /><b>Tulos:</b> bla bla <sup>Terve maailma</sup> bla bla",
'sub' => "Muuta teksti alaindeksiksi:<br /><br />Valitse teksti: bla bla [SELECT]Terve maailma[/SELECT] bla bla<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b> bla bla [sub]Terve maailma[/sub] bla bla<br /><br /><b>Tulos:</b> bla bla <sub>Terve maailma</sub> bla bla",
'list' => "Lis‰‰ lajittelematon luettelo yhdell‰ kohdalla:<br /><br />Valitse luettelon kohdan teksti: [SELECT]Kohta 1[/SELECT]<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b><br /><br />[list][*]Kohta 1<br />[/list]<br /><br />Lis‰t‰ksesi lis‰‰ kohtia sinun t‰ytyy kirjoittaa tagi ([*]) k‰sin:<br /><br />[list][*]Kohta 1<br />[*]Kohta 2<br />[*]Kohta 3<br />[/list]<br /><br /><b>Tulos:</b><ul><li>Kohta 1</li><li>Kohta 2</li><li>Kohta 3</li></ul>Voit luoda 2- tai 3-tasoisen listan sis‰llytt‰m‰ll‰ listan toisen listan sis‰ll‰:<br /><br />[list][*]Kohta 1<br />[*]Kohta 2[list][*]Alakohta 1<br />[*]Alakohta 2<br />[/list][*]Kohta 3<br />[/list]<br /><br /><b>Tulos:</b><ul><li>Kohta 1</li><li>Kohta 2<ul><li>Alakohta 1</li><li>Alakohta 2</li></ul></li><li>Kohta 3</li></ul><hr />[olist][*][/olist] YaBBC-tagit toimivat samalla tavalla kuin [list][*][/list]-tagit mutta luo lajitellun listan numeroilla luotien sijaan ([olist]-tagille ei ole lis‰yspainiketta).",
'me' => "Lis‰‰ nimesi (n‰yttˆnimi):<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b> /me sanoo Terve maailma<br /><br /><b>Tulos:</b> [ME] sanoo Terve maailma<br />",
'move' => "Siirr‰ teksti tai kuva viestin l‰pi oikealta vasemmalle:<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b> Siirret‰‰n maailmaa [move]Terve maailma[/move]<br /><br /><b>Tulos:</b><br />Siirret‰‰n maailmaa [MOVE]Terve maailma[/MOVE]",
'timestamp' => "Lis‰‰ aikaleima:<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b> [timestamp=1121602762]<br /><br />T‰m‰ tagi lis‰‰ aikaleiman lukijan (k‰ytt‰j‰t) valitsemassa aikamuodossa\.",
'bold' => "Vaihda teksti lihavoiduksi:<br /><br />Valitse teksti: bla bla [SELECT]Terve maailma[/SELECT] bla bla<br /><br />Napauta \"[TITLE]\"-painiketta: [BUTTON]<br /><br /><b>YaBBC-koodi:</b> bla bla [b]Terve maailma[/b] bla bla<br /><br /><b>Tulos:</b> bla bla <b>Terve maailma</b> bla bla",
