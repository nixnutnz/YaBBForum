            <br />ejemplo[/izquierda]
            <br />
            <br />[yabbc][izquierda]texto
ejemplo[/left][/yabbc]
        </td>
    </tr><tr>
        <td colspan="2"><hr /></td>
    </tr><tr>
        <th colspan="2"><span class="ubbcbutton ubbcbuttonback"><img src="$yyhtml_root/UBBCbuttons/center.png" alt="Botón de alineación central" /></span> Insertar texto alineado al centro</th>
    </tr><tr>
        <td>Sintaxis:
            <br />
            <br />
            <br />Resultado:
        </td>
        <td>[centro]texto
            <br />ejemplo[/centro]
