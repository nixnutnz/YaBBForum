%modulecheck = (
'1' => 'Pagsusuri ng Module',
'2' => 'Tinitingnan kung ang lahat ng Perl module na ginamit ng YaBBForum ay maayos na naka-install.',
'3' => 'Pangalan ng Module',
'4' => 'Impormasyon',
'5' => 'Impormasyon na ibinigay ng system:',
'6' => 'Naka-install',
'7' => 'Hindi naka-install ang ilang module sa iyong server.',
'8' => q~<b>Kung talagang kailangan mo ang mga ito (basahin ang Impormasyon), ang iyong unang pagpipilian ay ang hilingin sa iyong server host na i-install ang mga kinakailangang module para sa iyo.<br /><br />Kung hindi i-install ng iyong host ang module para sa iyo, pumunta sa <a href="https://perlhost.nz/" target="_blank"><b>Perlhost.nz</b></a> na dalubhasa sa Perl & um at YaBB.~,
'Digest::MD5' => 'Ginamit para sa pag-encrypt ng password.<br />Ang modyul na ito ay mahalaga. Kung wala ito, hindi gagana ang YaBBForum.',
'Time::HiRes' => 'Ginagamit para sa oras ng benchmarking kung pinagana ang debug.<br />Kung hindi naka-install ang modyul na ito, ang oras ng benchmarking ay ipapakita sa buong segundo at hindi sa high resolution na segundo. Kung hindi, hindi mo kailangan ang modyul na ito.',
'Oras::Local' => 'Ginamit para gawing timestamp ang mga string ng oras.<br />Ang modyul na ito ay mahalaga. Kung wala ito, hindi palaging gagana ang YaBBForum.',
'File::Find' => 'Ginamit para sa pag-upload ng avatar at attachment.<br />Kung hindi naka-install ang modyul na ito at pinagana ang mga feature na ito, makakakuha ka ng mga mensahe ng error kapag sinubukan mong mag-upload. Kung hindi, hindi mo kailangan ang modyul na ito.',
'CGI' => 'Ginamit para sa pag-upload ng avatar at attachment.<br />Kung hindi naka-install ang modyul na ito at pinagana ang mga feature na ito, makakakuha ka ng mga mensahe ng error kapag sinubukan mong mag-upload. Kung hindi, hindi mo kailangan ang modyul na ito.',
'Net::SMTP' => 'Ginamit upang magpadala ng mga e-mail sa pamamagitan ng SMTP.<br />Ang modyul na ito ay kailangan lamang kung gusto mong ipadala ang iyong mga e-mail sa pamamagitan ng Net::SMTP. Kung hindi, hindi mo kailangan ang modyul na ito.',
'Net::SMTP::TLS' => 'Ginamit upang magpadala ng mga e-mail sa pamamagitan ng SMTP::TLS.<br />Ang modyul na ito ay kailangan lamang kung gusto mong ipadala ang iyong mga e-mail sa pamamagitan ng Net::SMTP::TLS. Kung hindi, hindi mo kailangan ang modyul na ito.',
'Compress::Zlib' => 'Ginagamit para sa Backup feature at browser Output Compression.<br />Ang module na ito ay kailangan lang kung wala kang ibang Backup na paraan na available (tingnan ang Backup feature para sa mga detalye) at/o kung gusto mong paganahin ang "Gumamit ng GZip-Compression?". Kung hindi, hindi mo kailangan ang modyul na ito.',
'Compress::Bzip2' => 'Ginamit para sa Backup feature.<br />Ang modyul na ito ay kailangan lamang kung wala kang ibang Backup na paraan na magagamit (tingnan ang Backup feature para sa mga detalye). Kung hindi, hindi mo kailangan ang modyul na ito.',
'Archive::Tar' => 'Ginamit para sa Backup feature.<br />Ang modyul na ito ay kailangan lamang kung wala kang ibang paraan ng Backup na magagamit (tingnan ang Backup feature para sa mga detalye). Kung hindi, hindi mo kailangan ang modyul na ito.',
'Archive::Zip' => 'Ginamit para sa Backup feature.<br />Ang module na ito ay kailangan lamang kung wala kang ibang Backup na paraan na magagamit (tingnan ang Backup feature para sa mga detalye). Kung hindi, hindi mo kailangan ang modyul na ito.',
'MIME::Lite' => 'Ginagamit upang magpadala ng mga Backup na naka-attach sa isang e-mail.<br />Ang module na ito ay kailangan lamang kung gusto mong makuha ang Backup file sa pamamagitan ng e-mail at hindi sa pamamagitan ng direktang pag-download mula sa Admin Center. Kung hindi, hindi mo kailangan ang modyul na ito.',
'LWP::UserAgent' => 'Ginamit ng "GoogieSpell", aming Spell Checker.<br />Kung hindi naka-install ang modyul na ito, hindi mo maaaring paganahin ang Spell Checker. Kung hindi, hindi mo kailangan ang modyul na ito.',
'HTTP::Request::Common' => 'Ginamit ng "GoogieSpell", ang aming Spell Checker.<br />Kung hindi naka-install ang modyul na ito, hindi mo mapagana ang Spell Checker. Kung hindi, hindi mo kailangan ang modyul na ito.',
'Crypt::SSLeay' => 'Ginamit ng "GoogieSpell", ang aming Spell Checker.<br />Kung hindi naka-install ang modyul na ito, hindi mo maaaring paganahin ang Spell Checker. Kung hindi, hindi mo kailangan ang modyul na ito.',
'IO::Socket::INET' => 'Ginamit upang magpadala ng mga e-mail sa pamamagitan ng "YaBB SMTP Engine".<br />Kailangan lamang ang modyul na ito kung gusto mong ipadala ang iyong mga e-mail sa pamamagitan ng "YaBB SMTP Engine". Kung hindi, hindi mo kailangan ang modyul na ito.',
'Digest::HMAC_MD5' => 'Ginamit para magpadala ng mga e-mail sa pamamagitan ng "YaBB SMTP Engine".<br />Kailangan lamang ang modyul na ito kung gusto mong ipadala ang iyong mga e-mail sa pamamagitan ng "YaBB SMTP Engine". Kung hindi, hindi mo kailangan ang modyul na ito.',
'Carp' => 'Ginamit para magpadala ng mga e-mail sa pamamagitan ng "YaBB SMTP Engine" at magbigay ng seryosong babala sa server.',
'bytes' => 'Ginamit para magpadala ng mga e-mail sa pamamagitan ng "YaBB SMTP Engine".<br />Kailangan lamang ang modyul na ito kung gusto mong ipadala ang iyong mga e-mail sa pamamagitan ng "YaBB SMTP Engine". Kung hindi, hindi mo kailangan ang modyul na ito.',
'integer' => 'Ginamit upang magpadala ng mga e-mail sa pamamagitan ng "YaBB SMTP Engine".<br />Kailangan lamang ang modyul na ito kung gusto mong ipadala ang iyong mga e-mail sa pamamagitan ng "YaBB SMTP Engine". Kung hindi, hindi mo kailangan ang modyul na ito.',
'DateTime::TimeZone' => 'Ginamit upang makakuha ng mga offset ng Time Zone ng user at forum batay sa aktwal na time zone ng user.<br />Kailangan ang module na ito kung gusto mong itakda ang mga timezone ng forum/user sa anumang bagay maliban sa UTC.<br /><span class="important">Kailangang panatilihing napapanahon ang Module na ito dahil naglalaman ito ng time sensitive, data ng Time Zone.',
'DateTime::TimeZone2' => '<br />Ang iyong bersyon:',
'URI::Escape' => 'Ginamit ng Post/Message Preview function.<br />Ang module na ito ay mahalaga. Kung wala ito, hindi gagana ang Preview function.',
'perlver' => 'Iyong Bersyon ng Perl',
'Net::DNS' => 'Ginamit ng pinahusay na e-mail checker. Kung hindi naka-install ang module na ito, hindi mo mapapagana ang pinahusay na e-mail checker.',
'Mail::CheckUser' => 'Ginamit ng pinahusay na e-mail checker. Ang module na ito ay dapat na naka-install sa YaBBForum.',
);

