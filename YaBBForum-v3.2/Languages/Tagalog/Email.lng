$emaildesc{'boardnotificationemail'} = qq~Ang Notification E-mail (Board-Level, Umiiral na Paksa)~;
$boardnotificationemail = qq~Isang tugon, "{yabb subject}", ay nai-post mula sa {yabb tauthor} sa isang board na iyong pinapanood.

##########################################

{yabb tmessage}

##########################################

